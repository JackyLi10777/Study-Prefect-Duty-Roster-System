# Sing Yin Study Prefect Duty Roster — Environment Variables
# Copy this file to .env and fill in your values.
# Windows: setx VARIABLE_NAME "value"
# macOS/Linux: export VARIABLE_NAME="value"

# === Google Sheets (SSOT — Single Source of Truth) ===
# 1. Create a Google Cloud project + enable Sheets API
# 2. Create a Service Account + download JSON key
# 3. Share your Google Sheet with the service account email
# See SETUP.md for detailed instructions.

SY_SHEETS_KEY=service_account.json
SY_SHEETS_ID=your_google_sheet_id_here

# === NiceGUI Storage ===
# Required for app.storage.user. Auto-generated if not set.
# STORAGE_SECRET=dev-secret-sing-yin-roster-2026

# === DeepSeek AI (Remarks parsing + Column mapping) ===
# Get your API key from https://platform.deepseek.com
# AI features work without this, but parsing and import will be disabled.

SY_DEEPSEEK_KEY=sk-your-deepseek-key-here
