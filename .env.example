# Local mode creates and reuses data/runtime/.nicegui-storage-secret automatically.
# A future dedicated server must use a unique environment secret of at least 32 characters.
# SING_YIN_STORAGE_SECRET=

# The application is intentionally local-first. Keep this port bound to localhost.
SING_YIN_DEPLOYMENT_MODE=local
SING_YIN_HOST=127.0.0.1
SING_YIN_PORT=8080
# SQLite waits briefly when another browser tab is completing a write instead
# of failing immediately. Supported range: 1000-60000 milliseconds.
SING_YIN_SQLITE_BUSY_TIMEOUT_MS=10000
# Dedicated Windows Task Scheduler hosts should keep this false; the operator
# opens http://127.0.0.1:8080 manually. The double-click launcher still opens it.
# SING_YIN_OPEN_BROWSER=false

# Optional protected remote-browser settings. Keep them disabled until the
# Windows host is healthy and the Access app, named allow-list, Tunnel, and
# unauthenticated redirect test are complete. Use the activation script rather
# than editing these values piecemeal.
# SING_YIN_DEPLOYMENT_MODE=server
# Keep the NiceGUI origin loopback-only; cloudflared connects on the same host.
# SING_YIN_HOST=127.0.0.1
# SING_YIN_REMOTE_ACCESS_ENABLED=false
# SING_YIN_CLOUDFLARE_PROTECT_WITH_ACCESS=false
# SING_YIN_CLOUDFLARE_ACCESS_AUD=
# SING_YIN_CLOUDFLARE_TEAM_DOMAIN=
# SING_YIN_PUBLIC_HOSTNAME=

# v1.2 unified Admin / Guest gateway. Keep the feature flag disabled until the
# release report, fresh verified backup, isolated restore, origin readiness,
# Worker secrets, and Access path policy have all been checked together.
# SING_YIN_UNIFIED_GUEST=0
# SING_YIN_REQUIRE_GATEWAY_PRINCIPAL=1
# ORIGIN_PRINCIPAL_SECRET=
# ORIGIN_PRINCIPAL_KID=origin-v1
# AUTH_EPOCH=1
# SING_YIN_GUEST_SNAPSHOT_SECRET=

# Optional browser-direct, read-only roster viewer. This is separate from the
# full NiceGUI/WARP operator workspace. The base URL contains no secret; keep
# the generated administrator token only in the protected local .env and the
# Cloudflare Worker secret binding. Never place it in source or documentation.
# SING_YIN_PUBLIC_ROSTER_VIEWER_ENABLED=false
# SING_YIN_PUBLIC_ROSTER_VIEWER_BASE_URL=https://sing-yin-roster-viewer.singyin-study-prefect.workers.dev
# SING_YIN_PUBLIC_ROSTER_VIEWER_ADMIN_TOKEN=
# SING_YIN_PUBLIC_ROSTER_VIEWER_TIMEOUT_SECONDS=10
# Cloudflare KV is globally eventually consistent. The application confirms
# that the exact encrypted record is publicly readable before revealing its link.
# SING_YIN_PUBLIC_ROSTER_VIEWER_VISIBILITY_TIMEOUT_SECONDS=75

# Official visible YouTube player. Public playlist playback is free and needs
# no account. An optional Data API key enables in-app public music search.
SING_YIN_YOUTUBE_ENABLED=true
# SING_YIN_YOUTUBE_API_KEY=

# Optional schema-only DeepSeek assistance for prefect CSV/XLSX imports.
# It is opt-in: only column headings and anonymous value kinds are sent after
# the operator clicks the suggestion button. Raw rows and row-level Chinese names stay local.
# Manual mapping remains available when this is false. Use only a fresh key in
# the ignored local .env; never place a live key in source, docs, logs or backups.
SING_YIN_DEEPSEEK_ENABLED=false
SING_YIN_DEEPSEEK_MODEL=deepseek-v4-flash
# SING_YIN_DEEPSEEK_API_KEY=

# Optional local-only rotating support log directory. Never point this to a public sync folder.
# SING_YIN_LOG_DIR=D:\code_v3\logs

# Optional observability controls. Defaults preserve short, local-only retention and live terminal feedback.
# SING_YIN_LOG_LEVEL=INFO
# SING_YIN_LOG_CONSOLE=true
# SING_YIN_LOG_MAX_BYTES=2000000
# SING_YIN_LOG_BACKUP_COUNT=5

# PDF export normally embeds the three bundled Noto Sans HK weights. Override only after print testing.
# SING_YIN_PDF_FONT_REGULAR=C:\Path\To\Replacement-Regular.ttf
# SING_YIN_PDF_FONT_MEDIUM=C:\Path\To\Replacement-Medium.ttf
# SING_YIN_PDF_FONT_SEMIBOLD=C:\Path\To\Replacement-SemiBold.ttf
